<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Regla: Un empleado solo puede leer sus propios datos de teletrabajo (si no es gerente) -->
        <!-- Nota: En Odoo las reglas son aditivas. Esta regla asegura que el empleado tenga acceso a su registro. -->
        <record id="hr_employee_telework_personal_rule" model="ir.rule">
            <field name="name">Teletrabajo: Mis propios datos</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Un gerente puede ver y editar los datos de teletrabajo de sus subordinados directos -->
        <record id="hr_employee_telework_manager_rule" model="ir.rule">
            <field name="name">Teletrabajo: Mis subordinados</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla para Administradores de RRHH: Acceso total -->
        <record id="hr_employee_telework_hr_manager_rule" model="ir.rule">
            <field name="name">Teletrabajo: Administrador de RRHH</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
    </data>
</odoo>
