<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Telework Request Calendar View -->
    <record id="view_telework_request_calendar" model="ir.ui.view">
        <field name="name">telework.request.calendar</field>
        <field name="model">telework.request</field>
        <field name="arch" type="xml">
            <calendar string="Telework Requests"
                      date_start="date"
                      color="employee_id"
                      hide_time="true"
                      event_limit="5">
                <field name="employee_id" avatar_field="avatar_128"/>
                <field name="state" filters="1"/>
            </calendar>
        </field>
    </record>

    <!-- Telework Request Search View -->
    <record id="view_telework_request_search" model="ir.ui.view">
        <field name="name">telework.request.search</field>
        <field name="model">telework.request</field>
        <field name="arch" type="xml">
            <search string="Search Telework Requests">
                <field name="employee_id"/>
                <field name="date"/>
                <filter string="My Requests" name="my_requests" domain="[('employee_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirm')]"/>
                <filter string="Validated" name="validated" domain="[('state', '=', 'validate')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Telework Request Action -->
    <record id="action_telework_request_calendar" model="ir.actions.act_window">
        <field name="name">Telework Calendar</field>
        <field name="res_model">telework.request</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_telework_request_search"/>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your telework days!
            </p>
        </field>
    </record>

    <!-- Menu Item (Optional but useful for direct access) -->
    <menuitem id="menu_telework_root"
              name="Teletrabajo"
              sequence="10"
              web_icon="Teletrabajo,static/description/icon.png"/>

    <menuitem id="menu_telework_calendar"
              name="Calendar"
              parent="menu_telework_root"
              action="action_telework_request_calendar"
              sequence="10"/>
</odoo>
