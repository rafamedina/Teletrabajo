<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_telework" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.telework</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_telework_calendar"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar">
                    <field name="telework_count" widget="statinfo" string="Teletrabajo"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='work_location_id']" position="before">
                <field name="default_telework_day" placeholder="Escoge tu día predeterminado..."/>
                <field name="is_telework_manager" invisible="1"/>

                <label for="telework_state" string="Estado de Validación"/>
                <div class="o_row mb-3">
                    <field name="telework_state" widget="badge"
                           decoration-info="telework_state == 'draft'"
                           decoration-success="telework_state == 'validated'"/>

                    <button name="action_validate_telework"
                            string="Validar Teletrabajo"
                            type="object"
                            class="btn btn-primary btn-sm ms-2"
                            invisible="telework_state != 'draft' or not is_telework_manager"
                            confirm="¿Confirma la validación del horario de teletrabajo?"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
