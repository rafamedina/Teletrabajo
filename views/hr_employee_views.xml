<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PIEZA 2 (Vista) - INICIO -->
    <record id="view_employee_form_inherit_telework" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.telework</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(Teletrabajo.action_telework_request_calendar)d"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        type="action"
                        context="{'search_default_employee_id': id, 'default_employee_id': id}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Telework</span>
                        <span class="o_stat_text">Calendar</span>
                    </div>
                </button>
            </xpath>
            <!-- Usamos 'monday_location_id' como ancla técnica.
                 Insertamos el grupo de validación justo ANTES de que empiecen los días.
            -->
            <xpath expr="//field[@name='work_location_id']" position="after">
                <field name="is_telework_manager" invisible="1"/>
                <label for="telework_state" string="Estado Validación"/>
                <div class="o_row">
                    <field name="telework_state" widget="badge"
                           decoration-info="telework_state == 'draft'"
                           decoration-success="telework_state == 'validated'"/>

                    <button name="action_validate_telework"
                            string="Validar Teletrabajo"
                            type="object"
                            class="btn btn-primary btn-sm"
                            invisible="telework_state != 'draft' or not is_telework_manager"
                            confirm="¿Estás seguro de que deseas validar el teletrabajo para este empleado?"/>
                </div>
                <field name="parent_id" string="Gerente Autorizador" readonly="1"/>
            </xpath>
        </field>
    </record>
    <!-- PIEZA 2 (Vista) - FIN -->
</odoo>
